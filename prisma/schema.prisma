// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

enum Role {
  ADMIN
  USER
  MANAGER
}

enum Status {
  PENDING
  ONGOING
  COMPLETED
}

// Career

model Company {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String   @unique
  aboutUs            String
  whatWeDO           Json
  establishementYear DateTime
  officeStaff        Int
  fieldWorkers       Int
  projectsCount      Int // renamed from "Projects" to avoid confusion with relation

  // Relations
  services     Service[]
  users        User[]
  contacts     Contact[]
  projects     Project[]
  testimonials Testimonials[]
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  name      String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updateAt  DateTime  @updatedAt
  otp       String?
  otpExpire DateTime?

  // Relation
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
}

model Contact {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  phone          BigInt
  address        String
  openOfficeTime Json?
  email          String
  location       String

  // Relation
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
}

model Project {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  type                    String
  client                  String
  startDate               DateTime
  estimatedComplitionDate DateTime
  status                  Status
  manager                 String
  aboutProject            String
  description             String

  // Relation
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  features    String[]

  primaryBtn    String? // e.g. "Get a Quote"
  primaryLink   String? // e.g. "/quote"
  secondaryBtn  String? // e.g. "Learn More"
  secondaryLink String? // e.g. "/services/building"

  // Relation
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
}

model Testimonials {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  clientName  String?
  companyName String?
  feedback    String
  rating      Int
  // Relation
  Company     Company @relation(fields: [companyId], references: [id])
  companyId   String  @db.ObjectId
}
