### POST ================== Create Company Project ==================
POST {{base_url}}/auth/company/create-project
Content-Type: application/json

{
  "companyId": "68c1d52beb761ea90d99eb6c",
  "title": "Project Title",
  "category": "COMMERCIAL",
  "budget": 50000,
  "manager": "Alice Johnson",
  "aboutProject": "Short summary about the project.",
  "description": "Detailed description of the project.",
  "client": "Client Name",
  "startDate": "2023-10-01T00:00:00.000Z",
  "CompletionDate": "2024-03-31T00:00:00.000Z",
  "location": "Mumbai",
  "teamSize": 10,
  "status": "ONGOING",
  "milestones": [
    {
      "title": "Milestone 1",
      "dueDate": "2023-11-15",
      "status": "Completed"
    },
    {
      "title": "Milestone 2",
      "dueDate": "2024-01-31",
      "status": "In Progress"
    }
  ],
  "keyFeatures": ["Node.js", "React", "MongoDB"],
  "projectImage": ["image1.png", "image2.png"],
  "projectVideo": "video.mp4",
  "project360": "virtual-tour.mp4",
  "awards": [
    { "name": "Best Design", "year": 2023, "by": "ABC Org" }
  ]
}

