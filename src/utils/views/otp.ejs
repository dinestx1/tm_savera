<!DOCTYPE html>
<html>
<head>
  <title>OTP Verification</title>
</head>
<body>
  <h2>OTP Verification</h2>
  <p><%= message %></p>

<script>
  const email = "<%= email %>"; // ✅ explicitly assign email
  console.log("Email from EJS:", email);

  const userOtp = prompt("Enter OTP sent to " + email);

  if (userOtp) {
    fetch(`/verify/${encodeURIComponent("<%= email %>")}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ otp: userOtp })
    })
    .then(res => res.json())
    .then(data => {
      console.log("Response:", data);
      if (data.token) {
        window.location.href = `http://localhost:8080/${data.token}`;
      } else {
        alert(data.error || "OTP verification failed");
      }
    })
    .catch(err => alert("Error verifying OTP: " + err));
  }
</script>


</body>
</html>
